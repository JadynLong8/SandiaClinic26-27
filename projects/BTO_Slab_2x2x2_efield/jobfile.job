#!/bin/bash
#SBATCH --job-name=BTO_efield_test
#SBATCH --account=HMC120      # required on Expanse
#SBATCH --partition=shared               # or "compute" for a whole 128-core node
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=32
#SBATCH --mem=120G                       # set memory explicitly
#SBATCH -t 00:30:00
#SBATCH --output=slurm-%j.out
#SBATCH --export=ALL

module purge
module load cpu/0.15.4 slurm gcc/9.2.0 openmpi/3.1.6 openblas netlib-scalapack/2.1.0-openblas

export OMP_NUM_THREADS=1
ulimit -s unlimited

cd $SLURM_SUBMIT_DIR
srun --mpi=pmi2 -n $SLURM_NTASKS /expanse/lustre/projects/hmc120/jlong6/software/seqquest_parallel/quest_265a.x
